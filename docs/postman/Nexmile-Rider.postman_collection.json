{
    "info": {
        "name": "Nexmile — Rider app",
        "description": "Everything the **rider app** needs. Customer and merchant endpoints live in their own collections.\n\n**Auth is the same as the customer app except `intended_role: \"rider\"`.** There is no separate registration endpoint — the account is created on first verification, and comes back `pending` until an admin approves the documents.\n\n**There are no push notifications yet.** A rider only sees a new order while the app is open and polling, so build the board as something they watch — poll `/rider/orders/available` every 10–15 seconds while it is foregrounded.\n\nFull walkthrough: `docs/RIDER_APP_FLOW.md`",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{access_token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "1. Authentication",
            "description": "Identical to the customer app except `intended_role`. **Refuse non-riders**: if `role !== \"rider\"`, sign them out with \"This number is not registered as a delivery partner.\"",
            "item": [
                {
                    "name": "Request OTP",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/auth/otp/request",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "otp",
                                "request"
                            ]
                        },
                        "description": "The only difference from the customer app.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"{{email}}\",\n    \"intended_role\": \"rider\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                },
                {
                    "name": "Verify OTP",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/auth/otp/verify",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "otp",
                                "verify"
                            ]
                        },
                        "description": "The account comes back **`pending`** and that is correct — send them into the onboarding wizard, not a home screen.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"{{email}}\",\n    \"code\": \"{{otp_code}}\",\n    \"device_name\": \"Redmi 12\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const body = pm.response.json();",
                                    "if (body.data && body.data.access_token) {",
                                    "    pm.collectionVariables.set(\"access_token\", body.data.access_token);",
                                    "    pm.collectionVariables.set(\"refresh_token\", body.data.refresh_token);",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Refresh tokens",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/auth/refresh",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "refresh"
                            ]
                        },
                        "description": "One at a time. A rider signed out mid-shift loses an active delivery.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const body = pm.response.json();",
                                    "if (body.data && body.data.access_token) {",
                                    "    pm.collectionVariables.set(\"access_token\", body.data.access_token);",
                                    "    pm.collectionVariables.set(\"refresh_token\", body.data.refresh_token);",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Sign out",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/auth/logout",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "logout"
                            ]
                        },
                        "description": "Ends this session."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "2. Onboarding wizard",
            "description": "**Drive every step from `GET /rider/kyc`** — never from local state. Riders change devices, and an admin can reject a document *after* submission.",
            "item": [
                {
                    "name": "KYC status",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/kyc",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "kyc"
                            ]
                        },
                        "description": "Returns `missing_documents`, `can_submit` and a per-document `rejection_reason`. Render the wizard from this and enable Submit on `can_submit`.\n\nRejection is a **normal path**, not an error — blurred photos are the most common outcome. Show the reason per document and reopen the wizard for exactly those."
                    },
                    "response": []
                },
                {
                    "name": "Profile details",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/profile",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "profile"
                            ]
                        },
                        "description": "`vehicle_type` is `bicycle`, `motorcycle`, `scooter` or `ev`.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"full_name\": \"Selvam K\",\n    \"date_of_birth\": \"1996-04-12\",\n    \"vehicle_type\": \"motorcycle\",\n    \"vehicle_number\": \"TN59AB1234\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                },
                {
                    "name": "Document numbers",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/kyc/details",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "kyc",
                                "details"
                            ]
                        },
                        "description": "All optional — send what you have. Licence and insurance expiry **must be in the future**; surface that inline on the field.\n\nAadhaar and the bank account number are never returned once saved, so do not expect to read them back to prefill.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"aadhaar_number\": \"123456789012\",\n    \"pan\": \"ABCDE1234F\",\n    \"driving_licence_no\": \"TN5920190001234\",\n    \"driving_licence_expiry\": \"2030-04-12\",\n    \"vehicle_number\": \"TN59AB1234\",\n    \"rc_number\": \"RC123456\",\n    \"insurance_number\": \"INS987654\",\n    \"insurance_expiry\": \"2027-03-31\",\n    \"bank_account_name\": \"Selvam K\",\n    \"bank_account_number\": \"123456789012\",\n    \"bank_ifsc\": \"SBIN0001234\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                },
                {
                    "name": "Upload a document",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/kyc/documents",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "kyc",
                                "documents"
                            ]
                        },
                        "description": "**multipart/form-data.** JPG, PNG or PDF up to 10 MB — compress camera photos, a modern phone image exceeds that.\n\nRe-uploading a type replaces the previous file. Approved documents cannot be replaced.",
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "type",
                                    "value": "aadhaar_front",
                                    "type": "text",
                                    "description": "aadhaar_front | aadhaar_back | pan_card | driving_licence | vehicle_rc | vehicle_insurance"
                                },
                                {
                                    "key": "file",
                                    "type": "file",
                                    "src": []
                                }
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Remove a document",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/kyc/documents/{{document_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "kyc",
                                "documents",
                                "{{document_id}}"
                            ]
                        },
                        "description": "Pending or rejected only."
                    },
                    "response": []
                },
                {
                    "name": "Submit for verification",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/kyc/submit",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "kyc",
                                "submit"
                            ]
                        },
                        "description": "Once `can_submit` is true. Then a waiting screen — verification is a manual decision, usually within two working days."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "3. Profile and duty",
            "item": [
                {
                    "name": "My profile",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/profile",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "profile"
                            ]
                        },
                        "description": "Gate the whole working UI on **`can_accept_orders`**.\n\n`kyc.documents_expired` and the two expiry dates are how you warn a rider a week ahead — otherwise they find out at 8pm when a shift starts."
                    },
                    "response": []
                },
                {
                    "name": "Go on duty",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/duty-status",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "duty-status"
                            ]
                        },
                        "description": "Accepts `offline`, `available`, `on_break` only. `on_order` is set by dispatch — a rider cannot declare themselves busy to skip the queue.\n\n403 with a specific reason when not eligible: documents unverified, or licence/insurance expired. Show the message.\n\n422 while carrying an order — finish or hand it back first.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"duty_status\": \"available\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                },
                {
                    "name": "Go offline",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/duty-status",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "duty-status"
                            ]
                        },
                        "description": "Refused while an order is in hand.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"duty_status\": \"offline\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "4. Working a shift",
            "description": "Ready orders sit on a board that nearby on-duty riders poll, and the first to accept wins.",
            "item": [
                {
                    "name": "Send location",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/location",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "location"
                            ]
                        },
                        "description": "Every few seconds while on duty. **Doubles as a heartbeat** — stop pinging and the rider drops out of dispatch once the TTL lapses.\n\nAn offline rider gets 200 with `tracking: false`, not an error. Just stop the timer.\n\nBattery matters: coarse interval when idle, fine while carrying an order.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"latitude\": 9.9195,\n    \"longitude\": 78.1193\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                },
                {
                    "name": "Order board",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/orders/available",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "orders",
                                "available"
                            ]
                        },
                        "description": "Nearest restaurant first. Poll every 10–15 seconds while the screen is open.\n\n**`dropoff` is absent until you accept** — a board every on-duty rider can poll must not double as a list of where customers live.\n\n**`collect_cash`** is what to collect at the door: the full total for COD, `0` if prepaid. Getting it wrong costs the rider their own money.\n\nAn empty board is **not an error** — offline, unverified, already carrying an order, or no position sent. `meta.can_accept` says which, so you can show the right empty state."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const body = pm.response.json();",
                                    "if (body.data && body.data.length) {",
                                    "    pm.collectionVariables.set(\"order_id\", body.data[0].id);",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Accept an order",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/orders/{{order_id}}/accept",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "orders",
                                "{{order_id}}",
                                "accept"
                            ]
                        },
                        "description": "First to accept wins. A 422 saying **\"Another rider took this order\"** is expected on a shared board — refresh the list and move on, do not show it as a failure."
                    },
                    "response": []
                },
                {
                    "name": "Confirm pickup",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/orders/{{order_id}}/pickup",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "orders",
                                "{{order_id}}",
                                "pickup"
                            ]
                        },
                        "description": "The merchant reads out four digits. A wrong code is a 422 on `pickup_code` — let the rider retype rather than bouncing them out.\n\nThere is no \"I collected it\" button without the code: it is the evidence a disputed delivery is settled with.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"pickup_code\": \"{{pickup_code}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                },
                {
                    "name": "Hand the order back",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/orders/{{order_id}}/release",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "orders",
                                "{{order_id}}",
                                "release"
                            ]
                        },
                        "description": "Puts it back on the board for another rider. **Only before collection** — once the food is in the bag it has to be delivered.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"reason\": \"Puncture\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                },
                {
                    "name": "Confirm delivery",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/orders/{{order_id}}/deliver",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "orders",
                                "{{order_id}}",
                                "deliver"
                            ]
                        },
                        "description": "Closes the order, sets the rider back to `available` and increments `completed_deliveries`."
                    },
                    "response": []
                },
                {
                    "name": "My current delivery",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/orders",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "orders"
                            ],
                            "query": [
                                {
                                    "key": "active",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "`?active=1` is what the working screen polls after a restart — never resume from local state, a shift outlives an app process."
                    },
                    "response": []
                },
                {
                    "name": "Order details",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/rider/orders/{{order_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "rider",
                                "orders",
                                "{{order_id}}"
                            ]
                        },
                        "description": "Full order with pickup and dropoff. 404 if it belongs to another rider."
                    },
                    "response": []
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "https://api.nexmile.in/api/v1"
        },
        {
            "key": "email",
            "value": "rider@example.in"
        },
        {
            "key": "otp_code",
            "value": ""
        },
        {
            "key": "access_token",
            "value": ""
        },
        {
            "key": "refresh_token",
            "value": ""
        },
        {
            "key": "document_id",
            "value": ""
        },
        {
            "key": "order_id",
            "value": ""
        },
        {
            "key": "pickup_code",
            "value": ""
        }
    ]
}
