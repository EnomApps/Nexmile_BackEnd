{
    "info": {
        "name": "Nexmile — Customer App",
        "description": "Customer authentication and profile for the Flutter app.\n\n**There is no separate registration endpoint.** Sign-up and sign-in are the same two calls: request a code, then verify it. The account is created automatically the first time a code is verified for an unknown identifier.\n\n**Channel follows the identifier.** Send `email` and the code is emailed; send `phone` and it is texted. Email is live now; SMS is waiting on DLT registration. Never send both.\n\nRun the requests in order — `Verify OTP` stores the tokens into collection variables, so everything after it is already authenticated.\n\nWhile no mail transport is configured, the code is written to `storage/logs/laravel.log` on the server. Ask the backend team, or use a value set in `OTP_FIXED_CODE` on a non-production environment.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "https://api.nexmile.in/api/v1",
            "type": "string"
        },
        {
            "key": "email",
            "value": "customer@example.in",
            "type": "string"
        },
        {
            "key": "phone",
            "value": "9876543210",
            "type": "string"
        },
        {
            "key": "otp_code",
            "value": "",
            "type": "string"
        },
        {
            "key": "access_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "refresh_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "address_id",
            "value": "",
            "type": "string"
        },
        {
            "key": "restaurant_id",
            "value": ""
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{access_token}}",
                "type": "string"
            }
        ]
    },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Without this, validation failures come back as an HTML redirect",
                    "// instead of a 422 with the field errors.",
                    "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "1. Authentication",
            "item": [
                {
                    "name": "Request OTP (email)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('200 OK', () => pm.response.to.have.status(200));",
                                    "const d = pm.response.json().data;",
                                    "pm.test('channel is email', () => pm.expect(d.channel).to.eql('email'));",
                                    "// Only present outside production, so the app can be built",
                                    "// before a mail transport exists.",
                                    "if (d.debug_code) { pm.collectionVariables.set('otp_code', d.debug_code); }",
                                    "console.log('Code sent to', d.identifier, '· expires in', d.expires_in, 'seconds');"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{email}}\",\n  \"intended_role\": \"customer\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/otp/request",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "otp",
                                "request"
                            ]
                        },
                        "description": "Sends a 6-digit code.\n\nWorks for an unknown address — the account is created when the code is verified, so this doubles as registration.\n\n`intended_role` is `customer` or `rider` only, and applies only on first sign-in. Merchant and admin accounts cannot be created this way.\n\nLimits: 5 minutes validity, 60 seconds between requests, 5 codes per identifier per hour, 20 requests per IP per hour."
                    }
                },
                {
                    "name": "Request OTP (phone) — after DLT",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"intended_role\": \"customer\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/otp/request",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "otp",
                                "request"
                            ]
                        },
                        "description": "Identical call with a mobile number instead of an email. This is the only change needed when SMS goes live — no other endpoint or field changes.\n\nWill fail to deliver until DLT registration is complete."
                    }
                },
                {
                    "name": "Verify OTP → sign in",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('200 OK', () => pm.response.to.have.status(200));",
                                    "const d = pm.response.json().data;",
                                    "pm.collectionVariables.set('access_token', d.access_token);",
                                    "pm.collectionVariables.set('refresh_token', d.refresh_token);",
                                    "pm.test('returns a token pair', () => {",
                                    "  pm.expect(d.access_token).to.be.a('string');",
                                    "  pm.expect(d.refresh_token).to.be.a('string');",
                                    "  pm.expect(d.token_type).to.eql('Bearer');",
                                    "});",
                                    "console.log('Signed in as', d.user.email || d.user.phone, '· role', d.user.role);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{otp_code}}\",\n  \"device_name\": \"pixel-8\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/otp/verify",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "otp",
                                "verify"
                            ]
                        },
                        "description": "Exchanges the code for tokens, creating the account if the identifier is new.\n\nSend the **same identifier** used to request the code.\n\nReturns an access token valid 60 minutes and a refresh token valid 30 days.\n\nFive wrong attempts burn the code — the correct one stops working too, and a new code must be requested.\n\n`device_name` appears in the user's session list; send something recognisable like the device model.\n\n**Store the refresh token in Keychain / EncryptedSharedPreferences.** It is as sensitive as a password."
                    }
                },
                {
                    "name": "Refresh tokens",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('200 OK', () => pm.response.to.have.status(200));",
                                    "const d = pm.response.json().data;",
                                    "pm.collectionVariables.set('access_token', d.access_token);",
                                    "pm.collectionVariables.set('refresh_token', d.refresh_token);",
                                    "console.log('Rotated. Old tokens are now dead.');"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/refresh",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "refresh"
                            ]
                        },
                        "description": "Call this **once** after a 401, then retry the original request.\n\nBoth tokens are replaced; the old pair stops working immediately.\n\n**Serialise refreshes behind a single lock.** Two concurrent refreshes look like a stolen token to the server, and every session for that user is revoked."
                    }
                },
                {
                    "name": "Current user",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/auth/me",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "me"
                            ]
                        },
                        "description": "Returns 401 when the access token has expired — the signal to refresh."
                    }
                },
                {
                    "name": "Active sessions",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/auth/sessions",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "sessions"
                            ]
                        },
                        "description": "Every device currently signed in, for a \"where am I signed in\" screen."
                    }
                },
                {
                    "name": "Sign out (this device)",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/auth/logout",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "logout"
                            ]
                        },
                        "description": "Revokes the token used for this request and its refresh token. Other devices stay signed in."
                    }
                },
                {
                    "name": "Sign out everywhere",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/auth/logout-all",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "logout-all"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "2. Profile",
            "item": [
                {
                    "name": "Get profile",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/profile",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "profile"
                            ]
                        }
                    }
                },
                {
                    "name": "Update profile",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Karthik Raja\",\n  \"preferred_locale\": \"ta\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/profile",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "profile"
                            ]
                        },
                        "description": "Editable: `name`, `email`, `phone`, `preferred_locale` (`en`, `ta`, `hi`).\n\n`role` and `status` are ignored — a user cannot promote themselves or lift a suspension.\n\nChanging a verified email or phone clears that verification, so the user must confirm the new one."
                    }
                },
                {
                    "name": "Close account",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/profile",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "profile"
                            ]
                        },
                        "description": "Soft delete — past orders and invoices are retained for tax purposes. All sessions are revoked."
                    }
                }
            ]
        },
        {
            "name": "3. Delivery addresses",
            "item": [
                {
                    "name": "List addresses",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/addresses",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "addresses"
                            ]
                        },
                        "description": "Default address first, then most recently added."
                    }
                },
                {
                    "name": "Add address",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('201 Created', () => pm.response.to.have.status(201));",
                                    "pm.collectionVariables.set('address_id', pm.response.json().data.id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"label\": \"home\",\n  \"line1\": \"12 West Masi Street\",\n  \"line2\": \"Near Meenakshi Temple\",\n  \"landmark\": \"Opposite the bus stand\",\n  \"city\": \"Madurai\",\n  \"state\": \"Tamil Nadu\",\n  \"pincode\": \"625001\",\n  \"latitude\": 9.9252007,\n  \"longitude\": 78.1197754,\n  \"contact_name\": \"Karthik\",\n  \"contact_phone\": \"9876543210\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/addresses",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "addresses"
                            ]
                        },
                        "description": "`latitude` and `longitude` are **required** — the 1 km discovery cannot match a merchant without them. Take them from the device GPS or a map picker, not by geocoding the typed address.\n\n`label` is `home`, `work` or `other`.\n\nThe first address saved becomes the default automatically."
                    }
                },
                {
                    "name": "Update address",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"landmark\": \"Next to the pharmacy\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/addresses/{{address_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "addresses",
                                "{{address_id}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Set as default",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/addresses/{{address_id}}/default",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "addresses",
                                "{{address_id}}",
                                "default"
                            ]
                        },
                        "description": "Only one address is default at a time; the previous one is demoted automatically."
                    }
                },
                {
                    "name": "Delete address",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/addresses/{{address_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "addresses",
                                "{{address_id}}"
                            ]
                        },
                        "description": "If the default is deleted, the next most recent address is promoted, so the customer is never left without one."
                    }
                }
            ]
        },
        {
            "name": "4. Restaurants",
            "description": "Discovery and menu browsing (EP3, EP4). Not role-gated: a rider ordering dinner is a customer here.",
            "item": [
                {
                    "name": "Nearby restaurants (by address)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{access_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/restaurants",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "restaurants"
                            ],
                            "query": [
                                {
                                    "key": "address_id",
                                    "value": "{{address_id}}"
                                }
                            ]
                        },
                        "description": "Ranked open-first then nearest. Closed shops are listed below open ones, not hidden. meta.radius_metres tells you the radius that was applied."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const body = pm.response.json();",
                                    "if (body.data && body.data.length) {",
                                    "    pm.collectionVariables.set(\"restaurant_id\", body.data[0].id);",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Nearby restaurants (by GPS)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{access_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/restaurants",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "restaurants"
                            ],
                            "query": [
                                {
                                    "key": "latitude",
                                    "value": "9.9195"
                                },
                                {
                                    "key": "longitude",
                                    "value": "78.1193"
                                },
                                {
                                    "key": "search",
                                    "value": "",
                                    "disabled": true
                                }
                            ]
                        },
                        "description": "Same endpoint using raw device coordinates instead of a saved address."
                    },
                    "response": []
                },
                {
                    "name": "Restaurant details",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{access_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/restaurants/{{restaurant_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "restaurants",
                                "{{restaurant_id}}"
                            ],
                            "query": []
                        },
                        "description": "Storefront plus operating hours. is_open / is_accepting_orders / within_operating_hours are separate on purpose."
                    },
                    "response": []
                },
                {
                    "name": "Restaurant menu",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{access_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/restaurants/{{restaurant_id}}/menu",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "restaurants",
                                "{{restaurant_id}}",
                                "menu"
                            ],
                            "query": []
                        },
                        "description": "Categories with items, plus a top-level uncategorised array. Render both. Out-of-stock items are returned, not hidden."
                    },
                    "response": []
                }
            ]
        }
    ]
}
