APP_NAME=Nexmile
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Business time. Every opening-hours, daily-total and deal-window decision is a
# local-clock question, and India has no daylight saving.
APP_TIMEZONE=Asia/Kolkata

CORS_ALLOWED_ORIGINS=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexmile
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# phpredis on the server (apt install php-redis); predis for local dev on
# Windows, where the extension is not available.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Separate databases so cache:clear can never wipe live rider state.
REDIS_CACHE_DB=1
REDIS_LIVE_DB=2
REDIS_DISPATCH_DB=3

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@nexmile.in"
MAIL_FROM_NAME="Nexmile"

# KYC documents (Aadhaar, PAN, bank proof) live on a PRIVATE S3 bucket.
# Block all public access on the bucket; reads use short-lived signed URLs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=nexmile-documents
AWS_USE_PATH_STYLE_ENDPOINT=false

# Use s3 in production; "local" keeps files on disk for development.
KYC_DISK=s3

VITE_APP_NAME="${APP_NAME}"

# OTP auth (EP2)
# log = write the code to storage/logs/laravel.log until an SMS gateway exists.
SMS_DRIVER=log
SMS_SENDER_ID=NEXMLE

# Local/testing only — ignored when APP_ENV=production.
OTP_FIXED_CODE=

ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# Interactive API docs at /docs/api. Set false to hide them.
API_DOCS_ENABLED=true
API_VERSION=1.0.0

# Google Maps Platform — SERVER key only, IP-restricted to the EC2 elastic IP.
# The Flutter apps use their own platform-restricted keys; never share this one
# with them. The 1 km radius uses Redis GEO, not Google — see docs/MAPS.md.
GOOGLE_MAPS_SERVER_KEY=
